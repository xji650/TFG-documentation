% Zotero o Mendeley en format BibTeX).

@article{example_article,
    author  = {Cognom, Nom},
    title   = {Títol de l'article d'exemple},
    journal = {Nom de la revista},
    year    = {2024},
    volume  = {1},
    pages   = {1--10},
}

@inproceedings{example_inproceedings,
    author    = {Cognom, Nom},
